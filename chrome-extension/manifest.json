{
  "manifest_version": 3,
  "name": "Jira Token Relay",
  "version": "1.0.0",
  "description": "Automatically relays Jira session cookies to the Jira Ticket Creator VS Code extension.",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://jira.mycompany.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jira Token Relay"
  }
}
